{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Docker: Build and start",
            "type": "process",
            "command": "docker",
            "args": [
                "compose",
                "up",
                "--build",
                "--detach",
                "--wait",
                "starwars"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Docker: Stop",
            "type": "process",
            "command": "docker",
            "args": [
                "compose",
                "stop"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
