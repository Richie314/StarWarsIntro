# Adapted from Simple MVC's README: static assets bypass the front controller.
server {
    listen 80 default_server;
    server_name _;
    absolute_redirect off;
    root /starwars;
    access_log /dev/stdout;
    error_log /dev/stderr;
    index index.php;

    location ^~ ${SITE_PATH_PREFIX}/assets/ {
        alias /starwars/assets/;
        gzip on;
        gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml font/woff2;
        gzip_vary on;
        expires ${ASSET_CACHE_TTL};
    }

    # Preserve previously shared intro links with a canonical redirect.
    location = ${SITE_PATH_PREFIX}/view.php {
        return 308 ${SITE_PATH_PREFIX}/opening/view$is_args$args;
    }

    # AddController also enumerates the library's public static guard.
    # It is infrastructure, not an HTTP action.
    location ~ /RequireLogin$ {
        return 404;
    }

    location ~ /(?:app|vendor|preload|db|docker)(?:/|$) {
        return 404;
    }
    location ~ /\. {
        return 404;
    }

    location / {
        rewrite ^ ${SITE_PATH_PREFIX}/index.php last;
    }

    location = ${SITE_PATH_PREFIX}/index.php {
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php-fpm.sock;
        fastcgi_param SCRIPT_FILENAME /starwars/index.php;
        fastcgi_param HTTP_PROXY "";
    }
}
